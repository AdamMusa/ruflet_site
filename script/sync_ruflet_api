  "HueRingPicker" => { package: "color_pickers", common: true, sources: [ [ "material_hue_ring_picker.dart", %w[widget.control] ], [ "cupertino_hue_ring_picker.dart", %w[widget.control] ] ] },
  "MaterialPicker" => { package: "color_pickers", common: true, sources: [ [ "material_material_picker.dart", %w[widget.control] ], [ "cupertino_material_picker.dart", %w[widget.control] ] ] },
  "MultipleChoiceBlockPicker" => { package: "color_pickers", common: true, sources: [ [ "material_multiple_choice_block_picker.dart", %w[widget.control] ], [ "cupertino_multiple_choice_block_picker.dart", %w[widget.control] ] ] },
